      "variables": {
        "ΣF": {
          "name": "força resultante",
          "unit": "N"
        },
        "a": {
          "name": "aceleração",
          "unit": "m/s²"
        }
      },
      "when_to_use": "Verificar se um objeto está em equilíbrio ou em MRU",
      "restriction": "Referencial inercial"
    },
    {
      "id": "newton2-eq",
      "module": "forces",
      "experiment_ids": [
        "newton2-01"
      ],
      "latex": "\\vec{F} = m \\cdot \\vec{a}",
      "display": "F = m·a",
      "variables": {
        "F": {
          "name": "força resultante",
          "unit": "N"
        },
        "m": {
          "name": "massa",
          "unit": "kg"
        },
        "a": {
          "name": "aceleração",
          "unit": "m/s²"
        }
      },
      "when_to_use": "Calcular aceleração dada força e massa, ou força necessária para uma aceleração",
      "restriction": "Referencial inercial; F = força resultante, não uma força isolada"
    },
    {
      "id": "friction-eq",
      "module": "forces",
      "experiment_ids": [
        "friction-01"
      ],
      "latex": "f_k = \\mu_k \\cdot N",
      "display": "fₖ = μₖ · N",
      "variables": {
        "fₖ": {
          "name": "força de atrito cinético",
          "unit": "N"
