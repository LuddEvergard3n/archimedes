{
  "equations": [
    {
      "id": "mru-eq",
      "module": "motion",
      "experiment_ids": [
        "mru-01"
      ],
      "latex": "x(t) = x_0 + v \\cdot t",
      "display": "x(t) = x₀ + v·t",
      "variables": {
        "x": {
          "name": "posição",
          "unit": "m"
        },
        "x₀": {
          "name": "posição inicial",
          "unit": "m"
        },
        "v": {
          "name": "velocidade",
          "unit": "m/s"
        },
        "t": {
          "name": "tempo",
          "unit": "s"
        }
      },
      "when_to_use": "Corpo em movimento com velocidade constante",
      "restriction": "Válida apenas para a = 0"
    },
    {
      "id": "mruv-v",
      "module": "motion",
      "experiment_ids": [
        "mruv-01"
      ],
      "latex": "v(t) = v_0 + a \\cdot t",
      "display": "v(t) = v₀ + a·t",
      "variables": {
        "v": {
          "name": "velocidade final",
          "unit": "m/s"
        },
        "v₀": {
          "name": "velocidade inicial",
          "unit": "m/s"
        },
        "a": {
          "name": "aceleração",
          "unit": "m/s²"
        },
        "t": {
          "name": "tempo",
          "unit": "s"
        }
      },
      "when_to_use": "Corpo com aceleração constante — velocidade em função do tempo",
      "restriction": "Válida apenas para a = cte"
    },
    {
      "id": "mruv-x",
      "module": "motion",
      "experiment_ids": [
        "mruv-01"
      ],
      "latex": "x(t) = x_0 + v_0 t + \\frac{1}{2} a t^2",
      "display": "x(t) = x₀ + v₀t + ½·a·t²",
      "variables": {
        "x": {
          "name": "posição",
          "unit": "m"
        },
        "x₀": {
          "name": "posição inicial",
          "unit": "m"
        },
        "v₀": {
          "name": "velocidade inicial",
          "unit": "m/s"
        },
        "a": {
          "name": "aceleração",
          "unit": "m/s²"
        },
        "t": {
          "name": "tempo",
          "unit": "s"
        }
      },
      "when_to_use": "Corpo com aceleração constante — posição em função do tempo",
      "restriction": "Válida apenas para a = cte"
    },
    {
      "id": "free-fall-eq",
      "module": "motion",
      "experiment_ids": [
        "free-fall-01"
      ],
      "latex": "h = \\frac{1}{2} g t^2 \\qquad v = g \\cdot t",
      "display": "h = ½·g·t²     v = g·t",
      "variables": {
        "h": {
          "name": "altura percorrida",
          "unit": "m"
