        },
        "t": {
          "name": "tempo de queda",
          "unit": "s"
        },
        "v": {
          "name": "velocidade de impacto",
          "unit": "m/s"
        }
      },
      "when_to_use": "Objeto em queda livre a partir do repouso, sem resistência do ar",
      "restriction": "v₀ = 0; sem resistência do ar; g constante (h << R_Terra)"
    },
    {
      "id": "newton1-eq",
      "module": "forces",
      "experiment_ids": [
        "inertia-01"
      ],
      "latex": "\\sum F = 0 \\implies a = 0",
