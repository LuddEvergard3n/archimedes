          "name": "força normal",
          "unit": "N"
        }
      },
      "when_to_use": "Objeto já em movimento sobre superfície",
      "restriction": "Atrito cinético (movimento). Para estático: f_s ≤ μ_s · N"
    },
    {
      "id": "resultant-eq",
      "module": "forces",
      "experiment_ids": [
        "resultant-01"
      ],
      "latex": "\\vec{F}_R = \\vec{F}_1 + \\vec{F}_2",
      "display": "F_R = √(F₁² + F₂² + 2·F₁·F₂·cos θ)",
      "variables": {
        "F_R": {
          "name": "força resultante",
          "unit": "N"
        },
        "F₁": {
          "name": "força 1",
          "unit": "N"
        },
        "F₂": {
          "name": "força 2",
          "unit": "N"
        },
        "θ": {
          "name": "ângulo entre as forças",
          "unit": "rad"
        }
      },
      "when_to_use": "Composição de duas forças com ângulo qualquer entre elas",
      "restriction": "Para N forças, somar componentes x e y separadamente"
    },
    {
      "id": "energy-kinetic-eq",
      "module": "energy",
      "experiment_ids": [
        "kinetic-01",
        "conservation-01"
      ],
      "latex": "E_c = \\frac{1}{2} m v^2",
