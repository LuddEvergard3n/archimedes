    {
      "id": "energy-potential-eq",
      "module": "energy",
      "experiment_ids": [
        "ramp-energy-01",
        "conservation-01"
      ],
      "latex": "E_p = m \\cdot g \\cdot h",
      "display": "Ep = m·g·h",
      "variables": {
        "Ep": {
          "name": "energia potencial gravitacional",
