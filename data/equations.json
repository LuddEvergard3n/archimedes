          "name": "energia cinética",
          "unit": "J"
        },
        "m": {
          "name": "massa",
          "unit": "kg"
        },
        "v": {
          "name": "velocidade",
          "unit": "m/s"
        }
      },
      "when_to_use": "Qualquer corpo em movimento",
      "restriction": "Velocidades não relativísticas (v << c)"
